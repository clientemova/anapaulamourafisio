# Copie este arquivo para .env.local apenas se for testar a Vercel no seu computador.
# Nunca coloque valores reais no GitHub.

# Opcao recomendada para Vercel: cole o JSON da conta de servico convertido para Base64.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Opcao alternativa: use os tres campos abaixo em vez do Base64.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Observacao:
# A API key do Firebase Web App nao e usada por esta versao, porque o navegador
# nao acessa o Firestore direto. Quem acessa o banco e a API da Vercel com Admin SDK.

# Senha inicial da plataforma publicada.
# A Vercel grava uma versao protegida desta senha no Firestore no primeiro acesso.
# Depois que confirmar que a senha foi criada no banco, voce pode remover esta variavel da Vercel.
INITIAL_ADMIN_PASSWORD=
